{
  "schema": 1,
  "components": [
    {
      "id": "aref_carcare",
      "kind": "app",
      "path": "apps/aref_carcare",
      "manifest": "app.zh-CN.json",
      "title": "车辆养护",
      "description": "独立记录机油、火花塞、滤芯及各类油液的保养周期，支持首页组件；不重置原车保养提醒。",
      "mguHmi": [
        "ID7"
      ],
      "requires": {
        "idrive7-renderd": "2.1.7",
        "mgu-inputgate": "1.0.0"
      },
      "icon": "icon.png",
      "build": {
        "python": "localization/build_zh_cn.py",
        "args": [
          "{id}"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz",
        "shared": [
          "kit",
          "apps",
          "localization"
        ]
      }
    },
