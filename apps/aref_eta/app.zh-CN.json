{
  "id": "aref_eta",
  "title": "导航到达时间",
  "description": "显示苹果地图导航的到达时间、剩余时间和距离，支持首页组件及仪表信息条；仪表显示需要渲染组件。",
  "version": "1.20.101",
  "vendor": "aref",
  "loggingId": "OAR7",
  "mguAppStartType": "autostart",
  "startWidget": {
    "comment": "Home-screen widget (kit/runtime/homewidget.js): the big size is a 384 x 256 picture main.js draws, the small size two text lines.",
    "name": "预计到达时间",
    "layout": "LT_Table_OnlineApps_DriveRecorderWidget",
    "image": "BackgroundImage1",
    "size": [
      384,
      256
    ],
    "safe": [
      0.09,
      0.1
    ],
    "cells": {
      "ErrorInfo": [
        false,
        "Bool"
      ],
      "background": [
        true,
        "Bool"
      ],
      "Title": [
        "",
        "Text"
      ],
      "ProgressbarVisible": [
        false,
        "Bool"
      ],
      "Progress": [
        0,
        "Float"
      ],
      "TextRecordings": [
        "",
        "Text"
      ],
      "TextCam": [
        "",
        "Text"
      ],
      "TimeElapsed": [
        "",
        "Text"
      ],
      "TimeRemaining": [
        "",
        "Text"
      ]
    }
  },
  "signals": {
    "de.bmw.infotainment.navigation.projectedmodeguiding.ProjectedModeGuiding": {
      "_instances": "Main_Instance",
      "waypoints": "rs",
      "currentRoad": "rs",
      "activeRouteChange": "rs"
    },
    "de.bmw.infotainment.navigation.guiding.Guidance": {
      "_instances": "Main_Instance",
      "finalDestinationInfo": "rs",
      "nextDestinationInfo": "rs",
      "allDestinationsInfo": "rs",
      "guidanceState": "rs",
      "guidingProvider": "rs",
      "currentRoad": "rs",
      "travelledDistance": "rs",
      "travelledTime": "rs"
    },
    "de.bmw.infotainment.a4a.carplay.CarPlayManager": "*",
    "de.bmw.infotainment.navigation.navigationstatus.NavigationStatus": {
      "_optional": "the street name under the island",
      "currentLocation": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "_optional": "oil and coolant temperature in the second slot",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "_optional": "g in the second slot",
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusLateralAccelerationMassCenter": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "_optional": "the gear in the second slot",
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infotainment.misc.MDrive": {
      "_optional": "the gearbox program (S / M) in the second slot",
      "dataDisplayGearbox": "s"
    },
    "de.bmw.infotainment.entertainment.mediaplayer.MediaPlayer": "*",
    "de.bmw.infotainment.hmi.hmimediastate.HmiMediaState": "*",
    "de.bmw.infotainment.entertainment.dynamicmediaplayer.DynamicMediaPlayer": "*",
    "de.bmw.infotainment.KombiInterface_2": {
      "_optional": "hiding the ETA while BMW shows a Check Control message",
      "newCCMessage": "rs"
    }
  },
